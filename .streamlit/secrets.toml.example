# KARAKOÇ — Streamlit Secrets ÖRNEĞİ
#
# Bu dosyayı `.streamlit/secrets.toml` olarak kopyalayın ve GERÇEK değerleri
# girin. `.streamlit/secrets.toml` Git'e EKLENMEZ (.gitignore).
#
# Yerel geliştirme:  .streamlit/secrets.toml
# Üretim (Streamlit Cloud): Settings → Secrets

# Yönetici kullanıcı adı (isteğe bağlı; varsayılan "admin")
KARAKOC_ADMIN_USERNAME = "admin"

# Yönetici parolası — GÜÇLÜ ve TAHMİN EDİLEMEZ olmalı.
# Kodda/README'de açık metin parola tutmayın.
KARAKOC_ADMIN_PASSWORD = "BURAYA-GUCLU-BIR-PAROLA-YAZIN"

# İsteğe bağlı: veritabanı yolunu kalıcı bir diske yönlendirme.
# KARAKOC_DB_PATH = "/mnt/kalici/karakoc/yks_veritabani.db"
